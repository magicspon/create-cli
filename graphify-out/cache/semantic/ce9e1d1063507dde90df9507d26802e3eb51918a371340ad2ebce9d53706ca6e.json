{"nodes": [{"id": "readme_picking_a_directory", "label": "Picking a directory", "file_type": "document", "source_file": "README.md", "source_location": "### Picking a directory", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fuzzy_directory_search", "label": "Fuzzy Directory Search in the Create Wizard", "file_type": "concept", "source_file": "README.md", "source_location": "### Picking a directory", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The directory prompt searches the real tree under src/ instead of asking the user to recall it, because a typo there is the one step of `create` that silently succeeds - writing a fixture into a directory nobody imports from. Matching is subsequence-based rather than substring so an abbreviation like `slgen` finds `src/lib/gen`; adjacency and segment-boundary hits rank highest because that is what a person typing an abbreviation means."}, {"id": "readme_anchored_new_directory", "label": "Anchored New Directory Creation", "file_type": "concept", "source_file": "README.md", "source_location": "### Picking a directory", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A typed name that matches nothing is created inside the row currently highlighted rather than at the cwd, so navigating to a location and typing a child name does the obvious thing. A path containing a `/` is taken literally instead, which is the escape hatch out of the highlighted location. The directory is created lazily at write time, so abandoning the wizard at a later prompt leaves no empty directory behind."}], "edges": [{"source": "readme_picking_a_directory", "target": "readme_guided_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_fuzzy_directory_search", "target": "readme_picking_a_directory", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_anchored_new_directory", "target": "readme_picking_a_directory", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_fuzzy_directory_search", "target": "cli_directories_createdirectorysearch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_fuzzy_directory_search", "target": "cli_directories_fuzzyscore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_anchored_new_directory", "target": "cli_directories_createdirectorysearch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_picking_a_directory", "target": "cli_directories", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_anchored_new_directory", "target": "cli_output_writeresult", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}, {"source": "readme_picking_a_directory", "target": "commands_create_runcreate", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "### Picking a directory", "weight": 1.0}], "hyperedges": [{"id": "directory_prompt_flow