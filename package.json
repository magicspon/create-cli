{
  "name": "@magicspon/create-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "A configurable file scaffolder: one generator, one file, composed rather than bundled.",
  "keywords": [
    "scaffold",
    "generator",
    "codegen",
    "cli",
    "react"
  ],
  "license": "MIT",
  "author": "magicspon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicspon/create-cli.git"
  },
  "bugs": "https://github.com/magicspon/create-cli/issues",
  "homepage": "https://github.com/magicspon/create-cli#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "scaffold": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/define-config.d.mts",
      "default": "./dist/define-config.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "scaffold": "node src/index.ts",
    "build": "tsdown",
    "prepack": "pnpm build",
    "lint": "oxlint",
    "format": "oxfmt && oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "changeset publish",
    "yalc:publish": "pnpm build && yalc publish --push --no-scripts",
    "yalc:remove": "yalc installations clean @magicspon/create-cli",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "c12": "^3.3.4",
    "citty": "^0.2.2",
    "es-toolkit": "^1.52.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yalc": "1.0.0-pre.53"
  }
}
